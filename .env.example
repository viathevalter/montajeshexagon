# ==========================================
# HEXAGON MONTAJES — Variables de Entorno
# ==========================================
# Configura estas variables en el panel de Vercel (Project Settings -> Environment Variables)
# para recibir los formularios de presupuesto y candidaturas por correo o webhook.

# Correo de destino donde la dirección y RRHH de Hexagon recibirán los avisos
NOTIFICATION_EMAIL=contacto@hexagonmontajes.com

# ------------------------------------------------------------
# OPCIÓN A: Envío por SMTP (Nodemailer) - Recomendado
# Funciona con Gmail (App Password), Brevo, SendGrid, Amazon SES o tu servidor cPanel/Plesk
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@hexagonmontajes.com
SMTP_PASS=tu-password-o-app-token
SMTP_FROM="Hexagon Montajes" <no-reply@hexagonmontajes.com>

# ------------------------------------------------------------
# OPCIÓN B: Envío mediante Resend (API REST)
# Si prefieres usar Resend en lugar de SMTP, descomenta:
# ------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=Hexagon Montajes <notificaciones@tudominio.com>

# ------------------------------------------------------------
# OPCIÓN C: Webhook (Slack, Discord, Zapier, Make o CRM)
# Notificación simultánea en canal de operaciones / ventas
# ------------------------------------------------------------
# WEBHOOK_URL=https://discord.com/api/webhooks/...
