# ==========================================
# HEXAGON MONTAJES — Variables de Entorno (Vercel)
# ==========================================
# Configura estas variables en el panel de Vercel (Project Settings -> Environment Variables)
# para que todos los formularios (presupuesto, candidatos, contacto) lleguen a info@montajeshexagon.com.

# Correo de destino oficial de todos los formularios de la plataforma
NOTIFICATION_EMAIL=info@montajeshexagon.com

# ------------------------------------------------------------
# SERVIDOR SMTP DEL DOMINIO PROPIO (montajeshexagon.com)
# Configura con las credenciales SMTP del buzón de tu dominio
# (cPanel, Plesk, Titan Mail, Zoho, Microsoft 365, etc.)
# ------------------------------------------------------------
SMTP_HOST=mail.montajeshexagon.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@montajeshexagon.com
SMTP_PASS=tu_contraseña_de_correo
SMTP_FROM="Hexagon Montajes" <info@montajeshexagon.com>

# ------------------------------------------------------------
# ALTERNATIVA: Envío mediante API transaccional (Resend)
# Si vinculas tu dominio montajeshexagon.com en Resend:
# ------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM="Hexagon Montajes" <info@montajeshexagon.com>

# ------------------------------------------------------------
# OPCIÓN ADICIONAL: Webhook (Slack, Discord, Zapier, Make o CRM)
# Notificación simultánea inmediata en canal de ventas/operaciones
# ------------------------------------------------------------
# WEBHOOK_URL=https://discord.com/api/webhooks/...
